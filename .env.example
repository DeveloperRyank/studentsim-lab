# StudentSim Lab — environment example
# Copy to ".env" and fill in. The API key is ONLY read by the local Express
# server (server/index.mjs). It is never bundled into or exposed from the frontend.

# --- LLM provider (optional) -------------------------------------------------
# If unset, the app runs fully on the deterministic rule-based simulator.
# Any OpenAI-compatible chat-completions endpoint works.

# OpenAI
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Ollama (local, no key): set LLM_BASE_URL=http://localhost:11434/v1
# and LLM_MODEL=llama3.1  (leave LLM_API_KEY= as any non-empty value, e.g. "ollama")

# LM Studio / vLLM / other: point LLM_BASE_URL at the server's /v1 root.

# --- Server ------------------------------------------------------------------
PORT=8787
