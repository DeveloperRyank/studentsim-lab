{
  "name": "studentsim-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "StudentSim Lab — an AI student simulation research lab (simplified baseline inspired by microsoft/StudentSim).",
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,yellow \"vite\" \"node server/index.mjs\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  }
}
